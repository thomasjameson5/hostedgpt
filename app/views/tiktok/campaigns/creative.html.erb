<h1 class="text-3xl">Creative</h1>
<%= render "tiktok/campaigns/steps", campaign: @campaign, current_step: :creative %>

<% if @ad.errors.any? %>
  <div class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-lg mt-3 mb-3">
    <ul>
      <% @ad.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @ad, url: creative_tiktok_campaign_path(@campaign), method: :patch, class: "contents", local: true do |form| %>
  <div class="my-5">
    <span class="block font-medium mb-2">Video</span>
    <% if @videos.empty? %>
      <p class="text-gray-500">
        You don't have any uploaded videos yet.
        <%= link_to "Upload one", new_tiktok_video_path, class: "underline text-blue-600" %>.
      </p>
    <% else %>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
        <% @videos.each do |video| %>
          <label class="block border rounded-lg p-2 cursor-pointer <%= "border-blue-500 ring-2 ring-blue-300" if @ad.tiktok_video_id == video.id %>">
            <%= radio_button_tag "tiktok_ad[tiktok_video_id]", video.id, @ad.tiktok_video_id == video.id, id: nil %>
            <video class="w-full rounded mt-1" muted>
              <source src="<%= rails_blob_path(video.file, only_path: true) %>">
            </video>
            <p class="text-xs truncate mt-1"><%= video.caption.presence || "(no caption)" %></p>
          </label>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="my-5">
    <%= form.label :name, "Ad name" %>
    <%= form.text_field :name, class: "block shadow rounded-md border border-gray-200 outline-none px-3 py-2 mt-2 w-full dark:text-black" %>
  </div>

  <div class="my-5">
    <%= form.label :ad_text, "Ad text" %>
    <%= form.text_area :ad_text, rows: 2, class: "block shadow rounded-md border border-gray-200 outline-none px-3 py-2 mt-2 w-full dark:text-black" %>
  </div>

  <div class="my-5">
    <%= form.label :call_to_action %>
    <%= form.select :call_to_action, TiktokAd::CALL_TO_ACTIONS.map { |o| [o.titleize, o] }, {},
      class: "block border border-gray-200 outline-none shadow rounded-md px-3 py-2 mt-2 w-full dark:text-black" %>
  </div>

  <% if @campaign.objective_type == "LEAD_GENERATION" %>
    <div class="my-5">
      <%= form.label :instant_form_id, "Instant Form ID" %>
      <%= form.text_field :instant_form_id, class: "block shadow rounded-md border border-gray-200 outline-none px-3 py-2 mt-2 w-full dark:text-black" %>
      <p class="text-sm text-gray-500 mt-1">The ID of an Instant Form you've already built in TikTok Ads Manager.</p>
    </div>
  <% end %>

  <%= form.submit "Continue",
    class: "inline-block font-bold bg-gray-200 dark:bg-gray-900 border border-gray-400 rounded-lg py-3 px-5 cursor-pointer",
    data: { turbo_submits_with: "Saving..." } %>
<% end %>
