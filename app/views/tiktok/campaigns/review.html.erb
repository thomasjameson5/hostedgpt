<h1 class="text-3xl">Review &amp; launch</h1>
<%= render "tiktok/campaigns/steps", campaign: @campaign, current_step: :review %>

<% if @campaign.status == "failed" && @campaign.error_message.present? %>
  <div class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-lg mt-3 mb-5">
    TikTok rejected this campaign: <%= @campaign.error_message %>
  </div>
<% end %>

<div class="grid gap-5 md:grid-cols-2">
  <div class="border border-gray-300 dark:border-gray-600 rounded-lg p-4">
    <h2 class="font-bold mb-2">Campaign</h2>
    <dl class="text-sm space-y-1">
      <div><dt class="inline font-semibold">Name:</dt> <dd class="inline"><%= @campaign.name %></dd></div>
      <div><dt class="inline font-semibold">Objective:</dt> <dd class="inline"><%= @campaign.objective_type.titleize %></dd></div>
      <div><dt class="inline font-semibold">Budget:</dt> <dd class="inline"><%= number_to_currency(@campaign.budget) %> (<%= @campaign.budget_mode.titleize %>)</dd></div>
    </dl>
    <%= link_to "Edit", edit_tiktok_campaign_path(@campaign), class: "text-sm underline text-blue-600 mt-2 inline-block" %>
  </div>

  <div class="border border-gray-300 dark:border-gray-600 rounded-lg p-4">
    <h2 class="font-bold mb-2">Audience &amp; budget</h2>
    <dl class="text-sm space-y-1">
      <div><dt class="inline font-semibold">Ad group budget:</dt> <dd class="inline"><%= number_to_currency(@ad_group.budget) %></dd></div>
      <div><dt class="inline font-semibold">Starts:</dt> <dd class="inline"><%= @ad_group.schedule_start_time&.to_formatted_s(:long) || "not set" %></dd></div>
      <div><dt class="inline font-semibold">Ages:</dt> <dd class="inline"><%= [@ad_group.age_min, @ad_group.age_max].compact.presence&.join("-") || "all" %></dd></div>
      <div><dt class="inline font-semibold">Gender:</dt> <dd class="inline"><%= @ad_group.genders.presence&.join(", ") || "all" %></dd></div>
      <div><dt class="inline font-semibold">Locations:</dt> <dd class="inline"><%= @ad_group.location_ids.presence&.join(", ") || "not set" %></dd></div>
    </dl>
    <%= link_to "Edit", audience_tiktok_campaign_path(@campaign), class: "text-sm underline text-blue-600 mt-2 inline-block" %>
  </div>

  <div class="border border-gray-300 dark:border-gray-600 rounded-lg p-4 md:col-span-2">
    <h2 class="font-bold mb-2">Creative</h2>
    <dl class="text-sm space-y-1">
      <div><dt class="inline font-semibold">Video:</dt> <dd class="inline"><%= @ad.tiktok_video ? "attached" : "not selected" %></dd></div>
      <div><dt class="inline font-semibold">Ad text:</dt> <dd class="inline"><%= @ad.ad_text.presence || "not set" %></dd></div>
      <div><dt class="inline font-semibold">Call to action:</dt> <dd class="inline"><%= @ad.call_to_action.titleize %></dd></div>
      <% if @campaign.objective_type == "LEAD_GENERATION" %>
        <div><dt class="inline font-semibold">Instant Form:</dt> <dd class="inline"><%= @ad.instant_form_id.presence || "not selected" %></dd></div>
      <% end %>
    </dl>
    <%= link_to "Edit", creative_tiktok_campaign_path(@campaign), class: "text-sm underline text-blue-600 mt-2 inline-block" %>
  </div>
</div>

<div class="mt-8">
  <% if @campaign.ready_to_launch? %>
    <%= button_to "Launch campaign", launch_tiktok_campaign_path(@campaign), method: :post,
      class: "inline-block font-bold bg-green-600 text-white rounded-lg py-3 px-6 cursor-pointer",
      form: { data: { turbo_confirm: "Launch this campaign on TikTok now? This spends real ad budget." } } %>
  <% else %>
    <p class="text-gray-500">Finish every step above before you can launch.</p>
  <% end %>
</div>
