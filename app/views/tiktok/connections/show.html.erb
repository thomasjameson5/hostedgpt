<h1 class="text-3xl">Connected TikTok accounts</h1>

<p class="my-5 text-gray-600 dark:text-gray-300">
  This app posts videos and builds ad campaigns through
  <%= link_to "Zernio", "https://zernio.com", target: "_blank", class: "underline text-blue-600" %>,
  which holds the actual connection to TikTok. Connect or manage TikTok accounts on
  <%= link_to "your Zernio dashboard", "https://zernio.com/dashboard", target: "_blank", class: "underline text-blue-600" %> -
  they'll show up here automatically once connected.
</p>

<% if @accounts_error.present? %>
  <div class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-lg mt-3 mb-5">
    Couldn't load accounts from Zernio: <%= @accounts_error %>
  </div>
<% end %>

<% if @accounts_error.blank? %>
  <section class="my-8">
    <h2 class="text-xl font-bold mb-2">Posting account</h2>
    <p class="text-sm text-gray-500 mb-3">Videos you upload here get posted to this TikTok account.</p>

    <% if @posting_accounts.present? %>
      <%= render "tiktok/connections/accounts_table", accounts: @posting_accounts %>
    <% else %>
      <p class="text-gray-500">No TikTok posting account connected in Zernio yet.</p>
    <% end %>
  </section>

  <section class="my-8">
    <h2 class="text-xl font-bold mb-2">Ads / Business Center account</h2>
    <p class="text-sm text-gray-500 mb-3">Ad campaigns you launch here run through this TikTok Ads / Business Center account.</p>

    <% if @ads_accounts.present? %>
      <%= render "tiktok/connections/accounts_table", accounts: @ads_accounts %>
    <% else %>
      <div class="bg-yellow-50 text-yellow-800 px-3 py-2 rounded-lg">
        No TikTok Ads / Business Center account connected yet - launching a campaign will fail until you connect one.
        On <%= link_to "your Zernio dashboard", "https://zernio.com/dashboard", target: "_blank", class: "underline" %>,
        add a new account and choose the TikTok Ads / Business Center option (as opposed to the regular TikTok posting
        connection above) - it'll show up in this section automatically once connected.
      </div>
    <% end %>
  </section>
<% end %>
